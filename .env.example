POSTGRES_DB=ai_hiring
POSTGRES_USER=ai_hiring_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_hiring_user:replace_with_local_password@localhost:5432/ai_hiring
MAX_RESUME_UPLOAD_BYTES=10485760
MAX_RESUME_PAGES=5
MAX_DOCX_EXPANDED_BYTES=52428800
MAX_DOCX_ARCHIVE_ENTRIES=1000
MAX_DOCX_COMPRESSION_RATIO=100
RESUME_INTAKE_DIRECTORY=backend/runtime/resume_intake
RESUME_QUARANTINE_DIRECTORY=backend/runtime/quarantine
MIN_PDF_DIRECT_TEXT_CHARS=30
MAX_PDF_EXTRACTED_CHARS=500000
MAX_DOCX_EXTRACTED_CHARS=500000

# Authentication & Session Settings
SESSION_COOKIE_NAME=ai_hiring_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_LIFETIME_SECONDS=1800
SESSION_ABSOLUTE_LIFETIME_SECONDS=43200
LOGIN_FAILURE_THRESHOLD=5
LOGIN_COOLDOWN_SECONDS=900
FRONTEND_ORIGIN=http://localhost:5173

# Scrypt Password Hashing Parameters
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_DKLEN=32

# Model Provider & LLM Configuration (AI disabled by default)
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_PROFILE_NAME=Local Qwen3-4B
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b-instruct
LLM_API_MODE=chat_completions
LLM_API_KEY=
LLM_API_KEY_SECRET_REF=env:LLM_API_KEY
LLM_ALLOW_REMOTE=false
LLM_REMOTE_ALLOWED_HOSTS=
LLM_CONNECT_TIMEOUT_SECONDS=5.0
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_INPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_RESPONSE_BYTES=262144
LLM_MAX_CONCURRENCY=1
LLM_RETRY_LIMIT=0

# Streamlit Analytics Dashboard Configuration (Phase 4E.2)
DASHBOARD_TOKEN_SECRET=dashboard-local-secure-token-secret-change-in-prod
DASHBOARD_TICKET_TTL_SECONDS=120
DASHBOARD_SESSION_TTL_MINUTES=30
DASHBOARD_PUBLIC_URL=http://localhost:8501
DASHBOARD_API_BASE_URL=http://host.docker.internal:8000
REACT_APP_PUBLIC_URL=http://localhost:5173
DASHBOARD_REQUEST_TIMEOUT_SECONDS=10


